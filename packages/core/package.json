{
  "name": "@portiq/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./flows": {
      "import": "./src/flows/index.ts",
      "require": "./dist/flows/index.js"
    },
    "./ai": {
      "import": "./src/ai/index.ts",
      "require": "./dist/ai/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({ type: 'commonjs' }))\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dagre": "^0.8.5",
    "fuse.js": "^7.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54"
  }
}
