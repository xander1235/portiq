{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "declaration": false,
    "noEmitOnError": false,
    "baseUrl": ".",
    "paths": {
      "@portiq/core/flows": ["../../node_modules/@portiq/core/src/flows/index.ts"]
    }
  },
  "exclude": ["**/*.test.ts"]
}
